# Server-side only: backend API URL used during SSR
API_URL=http://localhost:8080

# Client-side: backend API URL exposed to the browser (chat, search)
PUBLIC_API_URL=http://localhost:8080

# Client-side: Cloudflare Web Analytics token (optional; beacon omitted when unset)
PUBLIC_CF_ANALYTICS_TOKEN=

# Client-side: Cloudflare Turnstile site key protecting the AI chat.
# Leave empty locally to disable Turnstile (no widget, no X-Turnstile-Token header).
# Cloudflare test keys: 1x00000000000000000000AA (always passes),
# 2x00000000000000000000AB (always fails), 3x00000000000000000000FF (forces interactive).
PUBLIC_TURNSTILE_SITE_KEY=
